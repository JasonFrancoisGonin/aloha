{
  "name": "aloha-shared",
  "version": "1.1.0",
  "description": "The backend server of ALOHA",
  "author": "Fabrizio ZARO <fabrizio.zaro@ec.europa.eu>",
  "homepage": "",
  "license": "EUPL-1.2",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    "default": "./dist/index.js",
    "import": "./dist-module/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist-module/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig-module.json",
    "build-microbundle": "microbundle src/*.ts --globals @modelcontextprotocol/sdk/types.js=@modelcontextprotocol/sdk/types.js --no-sourcemap",
    "prebuild": "rm -rf ./dist/* && rm -rf ./dist-module/*",
    "dev": "tsc --project tsconfig.json && tsc --project tsconfig-module.json",
    "start-dev": "nodemon --watch 'src/**' --ext 'ts,json' --exec 'pnpm run build'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express-session": "^1.18.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.12.0",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
