{
  "name": "server",
  "version": "1.1.0",
  "description": "The backend server of ALOHA",
  "author": "Fabrizio ZARO <fabrizio.zaro@ec.europa.eu>",
  "homepage": "",
  "license": "EUPL-1.2",
  "main": "lib/server.js",
  "type": "module",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --inspect src/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias",
    "prebuild": "rm -rf ./dist/*",
    "pretest": "sed -i 's/\"type\": \"module\"/\"type\": \"commonjs\"/' package.json",
    "test": " pnpm mocha --exit ",
    "posttest": "sed -i 's/\"type\": \"commonjs\"/\"type\": \"module\"/' package.json",
    "start": "NODE_ENV=production node ./dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "aloha-shared": "link:../aloha-shared",
    "clone-deep": "^4.0.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "eventsource": "^4.0.0",
    "express": "^5.1.0",
    "express-prometheus-middleware": "^1.2.0",
    "express-session": "^1.18.1",
    "get-port": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.0",
    "node-cache": "^5.1.2",
    "node-fetch-native": "^1.6.6",
    "pino": "^9.6.0",
    "typed-inject": "^5.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.31.0",
    "@types/chai": "^5.2.2",
    "@types/clone-deep": "^4.0.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-prometheus-middleware": "^1.2.3",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.12.0",
    "@types/sinon": "^17.0.4",
    "chai": "^5.2.1",
    "chai-http": "^5.1.2",
    "eslint": "^9.31.0",
    "mocha": "^11.2.2",
    "mongodb-memory-server": "^10.1.4",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.36.0",
    "undici": "^7.7.0"
