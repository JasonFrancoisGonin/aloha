{
  "name": "server",
  "version": "1.1.0",
  "description": "The backend server of ALOHA",
  "author": "Fabrizio ZARO <fabrizio.zaro@ec.europa.eu>",
  "homepage": "",
  "license": "EUPL-1.2",
  "main": "lib/server.js",
  "type": "module",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "e2e": "NODE_ENV=e2e tsx watch --inspect src/server.ts",
    "dev": "tsx watch --inspect src/server.ts",
    "dev-brk": "tsx watch --inspect-brk src/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias",
    "prebuild": "rm -rf ./dist/*",
    "pretest": "sed -i 's/\"type\": \"module\"/\"type\": \"commonjs\"/' package.json",
    "test": " pnpm mocha --exit ; sed -i 's/\"type\": \"commonjs\"/\"type\": \"module\"/' package.json",
    "test:coverage": "c8 pnpm test",
    "start": "NODE_ENV=production node ./dist/server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.8",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "aloha-shared": "link:../aloha-shared",
    "clone-deep": "^4.0.1",
    "connect-mongo": "^5.1.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "eventsource": "^4.0.0",
    "express": "^5.1.0",
    "express-prometheus-middleware": "^1.2.0",
    "express-session": "^1.18.2",
    "get-port": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.0",
    "mongodb": "^6.19.0",
    "node-cache": "^5.1.2",
    "node-fetch-native": "^1.6.7",
    "openid-client": "^6.8.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "typed-inject": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.35.0",
    "@types/chai": "^5.2.2",
    "@types/clone-deep": "^4.0.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-prometheus-middleware": "^1.2.3",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.10",
    "@types/sinon": "^17.0.4",
    "c8": "^11.0.0",
    "chai": "^5.2.1",
    "chai-http": "^5.1.2",
    "eslint": "^9.35.0",
    "mocha": "^11.7.2",
    "mongodb-memory-server": "^10.2.0",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.36.0",
    "undici": "^7.16.0"
  }
}
