{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDirs": ["./src", "./tests"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["mocha", "node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "classic"
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["./src", "./tests/**/*.ts"],
  "exclude": ["node_modules"]
}
