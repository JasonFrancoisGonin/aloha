SERVER_PORT=3000 # server port, defaults to 3000
CLIENT_SECRET=replace me with a random secret key
# AUTHENTICATION_PLUGIN=path to authentication plugin

# Database configuration

# MongoDB
DB_URI=mongodb://127.0.0.1:27017/ALOHA # connection string to connect to MongoDB instance

# PostgreSQL
# DB_URI=postgresql://localhost:5432/aloha # connection string to connect to PostgreSQL instance

# Other databases are not supported for now.
